<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>UltimateRDP</AssemblyName>
    <NeutralLanguage>en</NeutralLanguage>
    <RootNamespace>UltimateRDP.Client</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
    <!-- Classic COM interop for the Remote Desktop ActiveX control (AxMSTSCLib). -->
    <MsRdpExComInterop>Legacy</MsRdpExComInterop>
  </PropertyGroup>

  <ItemGroup>
    <!-- Menus and status bar take the font of the form, which Windows Forms scales on
         every change of monitor DPI. Their own default font keeps the size it had for
         the DPI of the monitor the window opened on. -->
    <RuntimeHostConfigurationOption Include="System.Windows.Forms.ApplyParentFontToMenus" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UltimateRDP.Core\UltimateRDP.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Devolutions.MsRdpEx" Version="2026.10.26" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>UltimateRDP.Client.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
